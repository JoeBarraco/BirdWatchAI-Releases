{
  "name": "birdwatchai-screensaver",
  "version": "1.2.1",
  "description": "BirdWatchAI Community Feed screensaver for Windows with multi-monitor support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:screensaver": "electron . /s",
    "start:config": "electron . /c",
    "start:preview": "electron . --preview",
    "build": "npx electron-builder --win --config electron-builder.config.js",
    "postbuild": "node scripts/rename-to-scr.js"
  },
  "author": "BirdWatchAI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "dependencies": {
    "koffi": "^3.3.7"
  }
}
