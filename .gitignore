# Dependencies and build output for the screensaver companion app.
# package-lock.json is deliberately NOT ignored — it pins exact dependency
# versions and belongs in the repo so builds are reproducible.
screensaver/node_modules/
screensaver/dist/

# Secrets. THIS REPO IS PUBLIC (it serves www.birdwatchai.com via GitHub
# Pages), so anything committed here is world-readable. Supabase function
# secrets, the license signing key, and API keys belong in the Supabase
# dashboard — never in a file here.
*.pem
*.p8
private_key.xml
license_private_key*
.env
.env.*

# OS / editor noise
.DS_Store
Thumbs.db
